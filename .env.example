# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_PATH=./data/child_health.db

# JWT Authentication
# Use a strong, random 256-bit (32+ character) secret in production
JWT_SECRET=child-health-api-jwt-secret-key-2026-replace-in-production
JWT_EXPIRES_IN=1h

# Security & CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15

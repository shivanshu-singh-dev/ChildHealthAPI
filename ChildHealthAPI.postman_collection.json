{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "name": "Child Health API",
    "description": "Comprehensive Postman API test collection for Child Health API with pre-request scripts, automated test assertions, variable capture, and security test cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenUser2",
      "value": "",
      "type": "string"
    },
    {
      "key": "childId",
      "value": "",
      "type": "string"
    },
    {
      "key": "childIdDenied",
      "value": "",
      "type": "string"
    },
    {
      "key": "reminderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health & Discovery",
      "item": [
        {
          "name": "API Root & Route Directory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response returns API version 2.0.0\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.version).to.eql(\"2.0.0\");",
                  "    pm.expect(json).to.have.property(\"endpoints\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Health Check & Database Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Health status is ok and SQLite is connected\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"ok\");",
                  "    pm.expect(json.database.connected).to.be.true;",
                  "    pm.expect(json.database.driver).to.eql(\"better-sqlite3\");",
                  "});",
                  "pm.test(\"Security headers are present\", function () {",
                  "    pm.response.to.have.header(\"x-content-type-options\");",
                  "    pm.response.to.have.header(\"x-frame-options\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register New Guardian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ananya Verma\",\n  \"email\": \"ananya.{{$timestamp}}@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"JWT token is issued\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.guardian).to.have.property(\"id\");",
                  "    pm.expect(json.expiresIn).to.eql(\"1h\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - User 1 (Captures Bearer Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"user1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Store JWT token into collection variable\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.collectionVariables.set(\"token\", json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - User 2 (Captures Bearer Token for BOLA Tests)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user2@example.com\",\n  \"password\": \"user2\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Store User 2 token into collection variable\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.collectionVariables.set(\"tokenUser2\", json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Invalid Password (Negative Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"wrong-password-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Error message is sanitized\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.eql(\"Unauthorized\");",
                  "    pm.expect(json.message).to.contain(\"Invalid email or password\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Child Profile Management",
      "item": [
        {
          "name": "Register Child - Granted Consent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"dateOfBirth\": \"2024-03-15\",\n  \"guardianName\": \"User One\",\n  \"state\": \"Maharashtra\",\n  \"consentStatus\": \"granted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/children",
              "host": ["{{baseUrl}}"],
              "path": ["children"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Capture generated Child UUID\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json.name).to.eql(\"Aarav Sharma\");",
                  "    pm.expect(json.consentStatus).to.eql(\"granted\");",
                  "    pm.collectionVariables.set(\"childId\", json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register Child - Denied Consent (For Consent Tests)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Diya Sharma\",\n  \"dateOfBirth\": \"2024-06-20\",\n  \"guardianName\": \"User One\",\n  \"state\": \"Maharashtra\",\n  \"consentStatus\": \"denied\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/children",
              "host": ["{{baseUrl}}"],
              "path": ["children"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Capture Child with Denied Consent ID\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.consentStatus).to.eql(\"denied\");",
                  "    pm.collectionVariables.set(\"childIdDenied\", json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Retrieve Child Profile by ID (Owner Access)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/children/{{childId}}",
              "host": ["{{baseUrl}}"],
              "path": ["children", "{{childId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns the requested child profile\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(pm.collectionVariables.get(\"childId\"));",
                  "    pm.expect(json.name).to.eql(\"Aarav Sharma\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Retrieve Child Profile - BOLA / IDOR Violation (Negative Test)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUser2}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/children/{{childId}}",
              "host": ["{{baseUrl}}"],
              "path": ["children", "{{childId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Cross-guardian access denied message returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.eql(\"Forbidden\");",
                  "    pm.expect(json.message).to.contain(\"Access denied\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Retrieve Child Profile - Missing Token (Negative Test)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/children/{{childId}}",
              "host": ["{{baseUrl}}"],
              "path": ["children", "{{childId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Vaccination Reminders",
      "item": [
        {
          "name": "Schedule Reminder - Granted Consent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"childId\": \"{{childId}}\",\n  \"vaccineName\": \"Polio Booster\",\n  \"dueDate\": \"2026-12-15\",\n  \"status\": \"scheduled\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reminders",
              "host": ["{{baseUrl}}"],
              "path": ["reminders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Reminder created and ID captured\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json.vaccineName).to.eql(\"Polio Booster\");",
                  "    pm.collectionVariables.set(\"reminderId\", json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Schedule Reminder - Denied Consent Blocked (Negative Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"childId\": \"{{childIdDenied}}\",\n  \"vaccineName\": \"MMR\",\n  \"dueDate\": \"2026-11-20\",\n  \"status\": \"scheduled\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reminders",
              "host": ["{{baseUrl}}"],
              "path": ["reminders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Consent required error returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.eql(\"Consent Required\");",
                  "    pm.expect(json.message).to.contain(\"Active granted consent is required\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Schedule Reminder - Cross-Guardian Blocked (Negative Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUser2}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"childId\": \"{{childId}}\",\n  \"vaccineName\": \"Hepatitis B\",\n  \"dueDate\": \"2026-12-01\",\n  \"status\": \"scheduled\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reminders",
              "host": ["{{baseUrl}}"],
              "path": ["reminders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Ownership violation error returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.eql(\"Forbidden\");",
                  "    pm.expect(json.message).to.contain(\"cannot create reminders for a child you do not manage\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Schedule Reminder - Nonexistent Child ID (Negative Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"childId\": \"00000000-0000-0000-0000-000000000000\",\n  \"vaccineName\": \"BCG\",\n  \"dueDate\": \"2026-12-10\",\n  \"status\": \"scheduled\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reminders",
              "host": ["{{baseUrl}}"],
              "path": ["reminders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Child not found error returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.eql(\"Child not found\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
